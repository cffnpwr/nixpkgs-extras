#!/usr/bin/env bash
set -e
if [[ ! -d "/Users/cffnpwr/git/github.com/cffnpwr/nixpkgs-extras" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/Users/cffnpwr/git/github.com/cffnpwr/nixpkgs-extras")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/Users/cffnpwr/git/github.com/cffnpwr/nixpkgs-extras" true

# Update the mtime for .envrc.
# This will cause direnv to reload again - but without re-building.
touch "/Users/cffnpwr/git/github.com/cffnpwr/nixpkgs-extras/.envrc"

# Also update the timestamp of whatever profile_rc we have.
# This makes sure that we know we are up to date.
touch -r "/Users/cffnpwr/git/github.com/cffnpwr/nixpkgs-extras/.envrc" "/Users/cffnpwr/git/github.com/cffnpwr/nixpkgs-extras/.direnv"/*.rc
